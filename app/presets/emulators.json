      "repo": "SourMesen/Mesen2",
      "asset": "Windows\\.zip$",
      "exe": "Mesen.exe",
      "systems": [
        "nes",
        "snes",
        "gba",
        "pce",
        "sms"
      ],
      "args": {
        "*": [
          "--fullscreen",
          "{rom}"
        ]
