{
  "systems": {
    "pc": {
      "name": "PC (Windows)",
      "exts": []
    },
    "ps1": {
      "name": "PlayStation",
      "exts": [
        ".chd",
        ".cue",
        ".bin",
        ".iso",
        ".pbp",
        ".img",
        ".ecm"
      ],
      "emulator": "duckstation",
      "args": [
        "-fullscreen",
        "{rom}"
      ]
    },
    "ps2": {
      "name": "PlayStation 2",
      "exts": [
        ".chd",
        ".iso",
        ".cso",
        ".gz",
        ".bin"
      ],
      "emulator": "pcsx2",
      "args": [
        "-fullscreen",
        "--",
        "{rom}"
      ],
      "bios": true
    },
    "psp": {
      "name": "PSP",
      "exts": [
        ".iso",
        ".cso",
        ".pbp",
        ".chd"
      ],
      "emulator": "ppsspp",
      "args": [
        "--fullscreen",
        "{rom}"
      ]
    },
    "n64": {
      "name": "Nintendo 64",
      "exts": [
        ".z64",
        ".n64",
        ".v64"
      ],
      "emulator": "rmg",
      "args": [
        "--fullscreen",
        "{rom}"
      ]
    },
    "gc": {
      "name": "GameCube",
      "exts": [
        ".iso",
        ".rvz",
        ".gcm",
        ".gcz",
        ".ciso"
      ],
      "emulator": "dolphin",
      "args": [
        "-b",
        "-e",
        "{rom}"
      ]
    },
    "wii": {
      "name": "Wii",
      "exts": [
        ".iso",
        ".rvz",
        ".wbfs",
        ".wad"
      ],
      "emulator": "dolphin",
      "args": [
        "-b",
        "-e",
        "{rom}"
      ]
    },
    "dc": {
      "name": "Dreamcast",
      "exts": [
        ".chd",
        ".gdi",
        ".cdi",
        ".cue"
      ],
      "emulator": "flycast",
      "args": [
        "{rom}"
      ]
    },
    "xbox": {
      "name": "Xbox",
      "exts": [
        ".iso",
        ".xiso"
      ],
      "emulator": "xemu",
      "args": [
        "-full-screen",
        "-dvd_path",
        "{rom}"
      ],
      "bios": true
    },
    "x360": {
      "name": "Xbox 360",
      "exts": [
        ".iso",
        ".xex",
        ".zar"
      ],
      "emulator": "xenia",
      "args": [
        "--fullscreen=true",
        "{rom}"
      ]
    },
    "gba": {
      "name": "Game Boy Advance",
      "exts": [
        ".gba",
        ".gb",
        ".gbc"
      ],
      "emulator": "mgba",
      "args": [
        "-f",
        "{rom}"
      ]
    },
    "snes": {
      "name": "Super Nintendo",
      "exts": [
        ".sfc",
        ".smc"
      ],
      "emulator": "snes9x",
      "args": [
        "-fullscreen",
        "{rom}"
      ]
    },
    "nds": {
      "name": "Nintendo DS",
      "exts": [
        ".nds"
      ],
      "emulator": "melonds",
      "args": [
        "-f",
        "{rom}"
      ]
    },
    "genesis": {
      "name": "Mega Drive",
      "exts": [
        ".md",
        ".gen",
        ".bin",
        ".smd"
      ],
      "emulator": "retroarch",
      "core": "genesis_plus_gx"
    },
    "nes": {
      "name": "NES",
      "exts": [
        ".nes"
      ],
      "emulator": "retroarch",
      "core": "mesen"
    },
    "ps3": {
      "name": "PlayStation 3",
      "exts": [
        ".bin"
      ],
      "marker": "PS3_GAME/USRDIR/EBOOT.BIN",
      "title_up": 3,
      "emulator": "rpcs3",
      "bios": false
    },
    "wiiu": {
      "name": "Wii U",
      "exts": [
        ".wua",
        ".wud",
        ".wux",
        ".rpx"
      ],
      "emulator": "cemu"
    },
    "switch": {
      "name": "Nintendo Switch",
      "exts": [
        ".nsp",
        ".xci",
        ".nro"
      ],
      "emulator": "eden",
      "bios": true
    },
    "3ds": {
      "name": "Nintendo 3DS",
      "exts": [
        ".3ds",
        ".cci",
        ".cxi",
        ".3dsx"
      ],
      "emulator": "azahar"
    },
    "saturn": {
      "name": "Sega Saturn",
      "exts": [
        ".chd",
        ".cue"
      ],
      "emulator": "mednafen",
      "bios": true
    },
    "sms": {
      "name": "Master System / Game Gear",
      "exts": [
        ".sms",
        ".gg"
      ],
      "emulator": "retroarch",
      "core": "genesis_plus_gx"
    },
    "pce": {
      "name": "TurboGrafx-16 / PC Engine",
      "exts": [
        ".pce"
      ],
      "emulator": "mednafen"
    },
    "atari2600": {
      "name": "Atari 2600",
      "exts": [
        ".a26"
      ],
      "emulator": "stella"
    },
    "arcade": {
      "name": "Arcade (MAME)",
      "exts": [
        ".zip",
        ".7z"
      ],
      "emulator": "mame"
    },
    "dos": {
      "name": "MS-DOS",
      "exts": [
        ".conf",
        ".bat"
      ],
      "emulator": "dosbox"
    }
  },
  "emulators": {
    "duckstation": {
      "title": "DuckStation",
      "source": "github",
      "repo": "stenzek/duckstation",
      "exe": "duckstation-qt-x64-ReleaseLTCG.exe",
      "portable_flag": "portable.txt",
      "args": {
        "*": [
          "-fullscreen",
          "{rom}"
        ]
      },
      "asset": "windows-x64-release\\.zip$",
      "systems": [
        "ps1"
      ]
    },
    "pcsx2": {
      "title": "PCSX2",
      "source": "github",
      "repo": "PCSX2/pcsx2",
      "exe": "pcsx2-qt.exe",
      "portable_flag": "portable.ini",
      "args": {
        "*": [
          "-fullscreen",
          "--",
          "{rom}"
        ]
      },
      "asset": "windows-x64-Qt\\.7z$",
      "systems": [
        "ps2"
      ]
    },
    "ppsspp": {
      "title": "PPSSPP",
      "source": "github",
      "repo": "hrydgard/ppsspp",
      "exe": "PPSSPPWindows64.exe",
      "portable_flag": "memstick/",
      "args": {
        "*": [
          "--fullscreen",
          "{rom}"
        ]
      },
      "asset": "Windows-x64\\.zip$",
      "systems": [
        "psp"
      ]
    },
    "rmg": {
      "title": "Rosalie's Mupen GUI",
      "source": "github",
      "repo": "Rosalie241/RMG",
      "exe": "RMG.exe",
      "args": {
        "*": [
          "--fullscreen",
          "{rom}"
        ]
      },
      "asset": "Portable-Windows64.*\\.zip$",
      "systems": [
        "n64"
      ]
    },
    "dolphin": {
      "title": "Dolphin",
      "source": "url",
      "url": "https://dl.dolphin-emu.org/releases/2506a/dolphin-2506a-x64.7z",
      "exe": "Dolphin.exe",
      "portable_flag": "portable.txt",
      "description": "GameCube / Wii",
      "args": {
        "*": [
          "-b",
          "-e",
          "{rom}"
        ]
      },
      "systems": [
        "gc",
        "wii"
      ]
    },
    "flycast": {
      "title": "Flycast",
      "source": "github",
      "repo": "flyinghead/flycast",
      "exe": "flycast.exe",
      "args": {
        "*": [
          "{rom}"
        ]
      },
      "asset": "win64.*\\.zip$",
      "systems": [
        "dc"
      ]
    },
    "xemu": {
      "title": "xemu",
      "source": "github",
      "repo": "xemu-project/xemu",
      "exe": "xemu.exe",
      "args": {
        "*": [
          "-full-screen",
          "-dvd_path",
          "{rom}"
        ]
      },
      "asset": "^xemu-[0-9.]+-windows-x86_64\\.zip$",
      "systems": [
        "xbox"
      ]
    },
    "xenia": {
      "title": "Xenia Canary",
      "source": "github",
      "repo": "xenia-canary/xenia-canary",
      "exe": "xenia_canary.exe",
      "portable_flag": "portable.txt",
      "args": {
        "*": [
          "--fullscreen=true",
          "{rom}"
        ]
      },
      "asset": "xenia_canary_windows\\.7z$",
      "systems": [
        "x360"
      ]
    },
    "mgba": {
      "title": "mGBA",
      "source": "github",
      "repo": "mgba-emu/mgba",
      "exe": "mGBA.exe",
      "portable_flag": "portable.ini",
      "args": {
        "*": [
          "-f",
          "{rom}"
        ]
      },
      "asset": "win64\\.7z$",
      "systems": [
        "gba"
      ]
    },
    "snes9x": {
      "title": "Snes9x",
      "source": "github",
      "repo": "snes9xgit/snes9x",
      "exe": "snes9x-x64.exe",
      "args": {
        "*": [
          "-fullscreen",
          "{rom}"
        ]
      },
      "asset": "win32-x64\\.zip$",
      "systems": [
        "snes"
      ]
    },
    "melonds": {
      "title": "melonDS",
      "source": "github",
      "repo": "melonDS-emu/melonDS",
      "exe": "melonDS.exe",
      "args": {
        "*": [
          "-f",
          "{rom}"
        ]
      },
      "asset": "windows-x86_64\\.zip$",
      "systems": [
