    "retroarch": {
      "title": "RetroArch",
      "source": "url",
      "url": "https://buildbot.libretro.com/stable/1.22.2/windows/x86_64/RetroArch.7z",
      "exe": "retroarch.exe",
      "cores_url": "https://buildbot.libretro.com/nightly/windows/x86_64/latest/{core}_libretro.dll.zip",
      "cores": {
        "ps1": "swanstation",
        "n64": "mupen64plus_next",
        "snes": "snes9x",
        "nes": "mesen",
        "gba": "mgba",
        "genesis": "genesis_plus_gx",
        "sms": "genesis_plus_gx",
        "nds": "melonds",
        "psp": "ppsspp",
        "gc": "dolphin",
        "wii": "dolphin",
        "dc": "flycast",
        "arcade": "fbneo",
        "atari2600": "stella",
        "saturn": "mednafen_saturn",
        "pce": "mednafen_pce",
        "dos": "dosbox_pure",
        "ps2": "pcsx2"
      },
      "systems": [
        "ps1",
        "n64",
        "snes",
        "nes",
        "gba",
        "genesis",
        "sms",
        "nds",
        "psp",
        "gc",
        "wii",
        "dc",
        "arcade",
        "atari2600",
        "saturn",
        "pce",
        "dos",
        "ps2"
      ],
      "description": "Multi-sistema (cores baixados sob demanda)"
    },
    "rpcs3": {
      "title": "RPCS3",
      "source": "github",
      "repo": "RPCS3/rpcs3-binaries-win",
      "asset": "win64.*\\.7z$",
      "exe": "rpcs3.exe",
      "portable_flag": "config/",
      "systems": [
        "ps3"
      ],
      "args": {
        "*": [
          "--no-gui",
          "{rom}"
        ]
      },
      "description": "PlayStation 3 (pastas com PS3_GAME/USRDIR/EBOOT.BIN)"
    },
    "cemu": {
      "title": "Cemu",
