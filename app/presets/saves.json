{
 "_doc": "Onde cada jogo/emulador guarda saves. Variáveis: {docs} {appdata} {localappdata} {savedgames} {home} {gamedir} {emudir} {userprofile} {public}. 'match' é regex no título. 'kind': pc|emu.",
 "emulators": {
  "pcsx2":      {"paths": ["{emudir}/memcards", "{docs}/PCSX2/memcards"], "ext": [".ps2", ".mcd", ".mc2", ".psu", ".max", ".cbs"], "note": "Memory cards PCSX2 (.ps2). Saves avulsos (.psu/.max) precisam ser importados dentro do PCSX2 (Ferramentas → Memory cards)."},
  "duckstation": {"paths": ["{emudir}/memcards", "{docs}/DuckStation/memcards"], "ext": [".mcd", ".mcr", ".srm", ".mc"], "note": "Memory cards do DuckStation. Pra ROM específica: shared_card_1.mcd ou <nome da rom>.mcd."},
  "ppsspp":     {"paths": ["{emudir}/memstick/PSP/SAVEDATA", "{docs}/PPSSPP/PSP/SAVEDATA"], "ext": [], "folder": true, "note": "Cada save é uma PASTA (ex.: ULUS10041DATA00) — solte a pasta inteira."},
  "dolphin":    {"paths": ["{emudir}/User/GC", "{emudir}/User/Wii/title", "{docs}/Dolphin Emulator/GC", "{appdata}/Dolphin Emulator/GC"], "ext": [".gci", ".raw", ".sav"], "note": "GameCube: .gci em GC/USA/Card A. Wii: pasta title/<id>."},
  "rmg":        {"paths": ["{emudir}/Save/Game", "{emudir}/Data/Save/Game", "{appdata}/RMG/Save/Game"], "ext": [".eep", ".sra", ".fla", ".mpk", ".srm"], "note": "Nome do arquivo tem que bater com a ROM."},
  "simple64":   {"paths": ["{emudir}/Save", "{appdata}/simple64/Save"], "ext": [".eep", ".sra", ".fla", ".mpk", ".srm"]},
  "flycast":    {"paths": ["{emudir}/data", "{appdata}/flycast/data"], "ext": [".bin"], "note": "vmu_save_A1.bin etc. (VMU)."},
  "redream":    {"paths": ["{emudir}/vmu0.bin"], "ext": [".bin"]},
  "xemu":       {"paths": ["{emudir}", "{appdata}/xemu/xemu"], "ext": [".qcow2"], "note": "Saves ficam DENTRO da imagem do HD (xbox_hdd.qcow2). Substituir a imagem toca em tudo."},
  "xenia":      {"paths": ["{emudir}/content"], "ext": [], "folder": true, "note": "content/<titleid>/00000001/ — solte a pasta do jogo."},
  "mgba":       {"paths": ["{emudir}", "{gamedir}"], "ext": [".sav", ".ss0", ".ss1"], "note": "O .sav fica ao lado da ROM, com o mesmo nome."},
  "snes9x":     {"paths": ["{emudir}/Saves", "{gamedir}"], "ext": [".srm", ".000", ".001"]},
  "melonds":    {"paths": ["{gamedir}", "{emudir}"], "ext": [".sav", ".dsv"]},
  "retroarch":  {"paths": ["{emudir}/saves", "{emudir}/states"], "ext": [".srm", ".state", ".state1", ".sav", ".rtc"]},
  "rpcs3":      {"paths": ["{emudir}/dev_hdd0/home/00000001/savedata"], "ext": [], "folder": true, "note": "Cada save é uma pasta (ex.: BLUS30443-AUTOSAVE)."},
  "cemu":       {"paths": ["{emudir}/mlc01/usr/save/00050000"], "ext": [], "folder": true, "note": "mlc01/usr/save/00050000/<titleid>/user/80000001."},
  "eden":       {"paths": ["{emudir}/user/nand/user/save/0000000000000000", "{appdata}/eden/nand/user/save/0000000000000000"], "ext": [], "folder": true, "note": "Dentro vem uma pasta por perfil de usuário e, nela, uma por título (title id). Botão direito no jogo → 'Abrir pasta de save' no Eden mostra a certa."},
  "citron":     {"paths": ["{emudir}/user/nand/user/save/0000000000000000", "{appdata}/citron/nand/user/save/0000000000000000"], "ext": [], "folder": true},
  "azahar":     {"paths": ["{emudir}/user/sdmc/Nintendo 3DS", "{appdata}/Azahar/sdmc/Nintendo 3DS"], "ext": [], "folder": true},
  "mesen":      {"paths": ["{emudir}/Saves", "{docs}/Mesen2/Saves"], "ext": [".srm", ".sav"]},
  "ares":       {"paths": ["{emudir}/Saves", "{gamedir}"], "ext": [".sav", ".srm", ".ram"]},
  "mednafen":   {"paths": ["{emudir}/sav", "{emudir}/mcs"], "ext": [".sav", ".mcr", ".mcs"]},
  "mame":       {"paths": ["{emudir}/nvram", "{emudir}/sta"], "ext": [], "folder": true},
  "stella":     {"paths": ["{emudir}", "{docs}/Stella"], "ext": [".sav"]},
  "dosbox":     {"paths": ["{gamedir}"], "ext": [], "note": "Jogos de DOS salvam na própria pasta do jogo."}
 },
 "games": [
  {"match": "grand theft auto: san andreas|gta san andreas|gta sa", "paths": ["{docs}/GTA San Andreas User Files"], "ext": [".b"], "note": "GTASAsf1.b … GTASAsf8.b (slot 1–8)."},
  {"match": "grand theft auto: vice city|gta vice city", "paths": ["{docs}/GTA Vice City User Files"], "ext": [".b"]},
  {"match": "grand theft auto iii|gta 3|gta iii", "paths": ["{docs}/GTA3 User Files"], "ext": [".b"]},
  {"match": "grand theft auto iv|gta iv|gta 4", "paths": ["{localappdata}/Rockstar Games/GTA IV/savegames", "{appdata}/Microsoft/Windows/GTA IV/savegames"], "ext": [], "folder": true},
  {"match": "grand theft auto v|gta v|gta 5", "paths": ["{docs}/Rockstar Games/GTA V/Profiles"], "ext": [], "folder": true},
  {"match": "pro evolution soccer 20(0[8-9]|1[0-3])|pes 20(0[8-9]|1[0-3])", "paths": ["{docs}/KONAMI/Pro Evolution Soccer {year}/save", "{docs}/KONAMI/PES {year}/save"], "ext": [".bin", ".dat"], "note": "save/ (edit data, option file, master league)."},
  {"match": "pro evolution soccer 20(1[4-9]|2[01])|pes 20(1[4-9]|2[01])|efootball pes", "paths": ["{docs}/KONAMI/Pro Evolution Soccer {year}/save", "{docs}/KONAMI/eFootball PES 2021/save", "{docs}/KONAMI/eFootball PES 2020/save"], "ext": [".bin", ".dat"], "note": "Option files (EDIT00000000) vão em save/."},
  {"match": "pro evolution soccer (4|5|6)|winning eleven", "paths": ["{docs}/KONAMI/Pro Evolution Soccer {n}/save", "{docs}/KONAMI/Pro Evolution Soccer {n}"], "ext": [".bin", ".dat"], "note": "PES 5/6 salvam em Meus Documentos/KONAMI/Pro Evolution Soccer N/save."},
  {"match": "^fifa (0[5-9]|1[0-9]|2[0-3])|fifa world cup|ea sports fc", "paths": ["{docs}/FIFA {yy}", "{docs}/FIFA {year}", "{docs}/EA SPORTS FC {yy}"], "ext": [], "folder": true, "note": "Pasta inteira (settings, saves do modo carreira)."},
  {"match": "need for speed: most wanted( 2005)?$|nfs most wanted 2005|most wanted \\(2005\\)", "paths": ["{docs}/NFS Most Wanted"], "ext": [], "folder": true, "note": "Pasta NFS Most Wanted (perfis em Profiles/)."},
  {"match": "need for speed: underground 2|nfs underground 2", "paths": ["{docs}/NFS Underground 2"], "ext": [], "folder": true},
  {"match": "need for speed: underground$|nfs underground$", "paths": ["{docs}/NFS Underground"], "ext": [], "folder": true},
  {"match": "need for speed: carbon", "paths": ["{docs}/NFS Carbon"], "ext": [], "folder": true},
  {"match": "need for speed: prostreet", "paths": ["{docs}/NFS ProStreet"], "ext": [], "folder": true},
  {"match": "need for speed: undercover", "paths": ["{docs}/NFS Undercover"], "ext": [], "folder": true},
  {"match": "need for speed: hot pursuit \\(?2010", "paths": ["{docs}/Criterion Games/Need For Speed(TM) Hot Pursuit"], "ext": [], "folder": true},
  {"match": "need for speed: shift", "paths": ["{docs}/NFS SHIFT"], "ext": [], "folder": true},
  {"match": "need for speed: (2015|payback|heat|rivals|the run)", "paths": ["{docs}/Need for Speed", "{docs}/Need for Speed(TM) Payback", "{docs}/Need for Speed Heat", "{docs}/Need for Speed Rivals"], "ext": [], "folder": true},
  {"match": "colin mcrae rally 2005", "paths": ["{docs}/Codemasters/Colin McRae Rally 2005"], "ext": [], "folder": true},
  {"match": "colin mcrae: dirt|dirt 2|dirt 3|dirt rally|grid|toca|race driver|f1 20", "paths": ["{docs}/My Games/{title}", "{docs}/Codemasters/{title}"], "ext": [], "folder": true, "note": "Codemasters: Documentos/My Games/<nome do jogo>."},
  {"match": "tony hawk's underground 2|thug 2", "paths": ["{gamedir}/Game/Save", "{gamedir}/Save"], "ext": [".SAV", ".sav"], "note": "THUG2 salva dentro da pasta do jogo."},
  {"match": "tony hawk's (pro skater|underground$|american wasteland)|thps|thaw", "paths": ["{gamedir}/Save", "{gamedir}/Game/Save", "{gamedir}/Data/Save"], "ext": [".sav", ".SAV"]},
  {"match": "halo: combat evolved|halo custom edition", "paths": ["{docs}/My Games/Halo", "{docs}/My Games/Halo CE"], "ext": [], "folder": true},
  {"match": "halo 2", "paths": ["{localappdata}/Microsoft/Halo 2/Saved Games"], "ext": [], "folder": true},
  {"match": "midtown madness 2", "paths": ["{gamedir}/players"], "ext": [], "folder": true},
  {"match": "simpsons hit (&|and) run", "paths": ["{gamedir}/Saves", "{docs}/The Simpsons Hit & Run"], "ext": [], "folder": true},
  {"match": "sleeping dogs", "paths": ["{docs}/Square Enix/Sleeping Dogs", "{docs}/Sleeping Dogs Definitive Edition"], "ext": [], "folder": true},
  {"match": "mafia$|mafia: the city", "paths": ["{gamedir}/savegame"], "ext": [], "folder": true},
  {"match": "mafia ii", "paths": ["{appdata}/2K Games/Mafia II/Saves"], "ext": [], "folder": true},
  {"match": "max payne 2", "paths": ["{docs}/Max Payne 2 Savegames"], "ext": [], "folder": true},
  {"match": "max payne$", "paths": ["{docs}/Max Payne Savegames"], "ext": [], "folder": true},
  {"match": "far cry$|far cry 1", "paths": ["{docs}/Far Cry/SaveGames", "{gamedir}/Profiles"], "ext": [], "folder": true},
  {"match": "call of duty 2", "paths": ["{gamedir}/main/players"], "ext": [], "folder": true},
  {"match": "call of duty 4|modern warfare", "paths": ["{gamedir}/players/profiles"], "ext": [], "folder": true},
  {"match": "call of duty: world at war", "paths": ["{localappdata}/Activision/CoDWaW/players/profiles"], "ext": [], "folder": true},
  {"match": "battlefield 2$|battlefield 2:", "paths": ["{docs}/Battlefield 2/Profiles"], "ext": [], "folder": true},
  {"match": "battlefield 1942|battlefield vietnam", "paths": ["{gamedir}/Mods/bf1942/Settings/Profiles"], "ext": [], "folder": true},
  {"match": "battlefield (3|4|1|v|hardline)", "paths": ["{docs}/Battlefield {n}/settings", "{docs}/Battlefield {n}"], "ext": [], "folder": true},
  {"match": "lego", "paths": ["{appdata}/Warner Bros. Interactive Entertainment/{title}/SavedGames", "{docs}/Warner Bros. Interactive Entertainment/{title}", "{gamedir}/SavedGames"], "ext": [], "folder": true},
  {"match": "spider-man|spiderman", "paths": ["{docs}/{title}", "{gamedir}/Save", "{appdata}/Activision/{title}"], "ext": [], "folder": true},
  {"match": "star wars: (battlefront|republic commando|knights of the old republic|jedi)", "paths": ["{docs}/{title}", "{gamedir}/saves", "{gamedir}/GameData/SaveGames"], "ext": [], "folder": true},
  {"match": "splinter cell", "paths": ["{docs}/{title}/Save", "{gamedir}/Save"], "ext": [], "folder": true},
  {"match": "hitman", "paths": ["{docs}/Hitman {sub}", "{gamedir}/Save"], "ext": [], "folder": true},
  {"match": "zoo tycoon|black & white|the sims", "paths": ["{docs}/{title}", "{docs}/Electronic Arts/{title}"], "ext": [], "folder": true},
  {"match": "resident evil 4", "paths": ["{docs}/My Games/Capcom/RE4", "{gamedir}/savedata"], "ext": [], "folder": true},
  {"match": "devil may cry 4", "paths": ["{docs}/CAPCOM/DEVILMAYCRY4"], "ext": [], "folder": true},
  {"match": "assassin's creed", "paths": ["{localappdata}/Ubisoft Game Launcher/savegames", "{appdata}/Ubisoft/Assassin's Creed", "{gamedir}/Saves"], "ext": [], "folder": true},
  {"match": "prince of persia", "paths": ["{docs}/Prince of Persia*", "{appdata}/Ubisoft/Prince of Persia*"], "ext": [], "folder": true},
  {"match": "nba 2k|wwe 2k|mlb 2k", "paths": ["{appdata}/2K Sports/{title}/Saves", "{docs}/{title}/Saves"], "ext": [], "folder": true}
 ],
 "generic_pc": ["{docs}/{title}", "{docs}/My Games/{title}", "{savedgames}/{title}", "{appdata}/{title}", "{localappdata}/{title}", "{gamedir}/Save", "{gamedir}/Saves", "{gamedir}/savegame", "{gamedir}/savegames", "{gamedir}/SaveGames", "{gamedir}/profiles", "{gamedir}/Profiles"]
}
